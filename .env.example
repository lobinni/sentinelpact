# ------------------------------------------------------------------
# SentinelPact frontend configuration
# Copy to `.env.local` and adjust. All values are public by design.
# ------------------------------------------------------------------

# Canonical SentinelPact deployment on Studionet.
# OPTIONAL: when unset, the app uses DEFAULT_CONTRACT_ADDRESS in
# src/lib/genlayer/client.ts. Set this only to point at your own redeployment —
# it is the ONLY value that changes when the contract is redeployed.
NEXT_PUBLIC_SENTINELPACT_CONTRACT=0xD61eFb765F260F4D191C359D7a7413fcb59162Bf

# Network defaults — Studionet only (keep these values).
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_EXPLORER=https://explorer-studio.genlayer.com

# Platform database (optional). Only used by the local health endpoint.
# Leave unset for Vercel/static-style deployments — the app itself is
# fully on-chain and needs no database.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
